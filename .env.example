# Copy this file's variable into Vercel → Project → Settings → Environment Variables.
# Never commit a real .env file with actual values.

# SheetDB endpoint URL (from https://sheetdb.io) connected to your Google Sheet,
# used by api/save-response.js to save each completed diagnosis as a row.
SHEETDB_API_URL=https://sheetdb.io/api/v1/your-sheet-id
